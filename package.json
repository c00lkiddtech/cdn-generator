{
  "name": "cdn-generator",
  "version": "1.1.0",
  "description": "Generate CDN links for any GitHub repo (jsDelivr, esm.sh, GitHack, Statically, jsDelivr mirrors) and wildcard DNS hostnames for any IP (nip.io, sslip.io, traefik.me, backname.io, anyip.dev, local-ip.sh).",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "cdn-generator": "bin/cdn-generator.js",
    "cdngen": "bin/cdn-generator.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "cdn",
    "github",
    "jsdelivr",
    "esm.sh",
    "githack",
    "statically",
    "jsdmirror",
    "wildcard-dns",
    "nip.io",
    "sslip.io",
    "traefik.me",
    "local-ip",
    "cli"
  ],
  "author": "c00lkiddtech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c00lkiddtech/cdn-generator.git"
  },
  "bugs": {
    "url": "https://github.com/c00lkiddtech/cdn-generator/issues"
  },
  "homepage": "https://github.com/c00lkiddtech/cdn-generator#readme"
}
